#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
mkdir -p build/install/scryer/bin
go build -trimpath -o build/install/scryer/bin/scryer.new ./cmd/scryer
mv -f build/install/scryer/bin/scryer.new build/install/scryer/bin/scryer
# Remove artifacts owned by the former combined CLI/JVM distribution.
rm -rf build/install/scryer/lib build/install/scryer/runtime
rm -f build/install/scryer/bin/scryer.bat
